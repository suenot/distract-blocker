---
const steps = [
  { n: 1, title: 'Add the sites you want gone', body: 'One by one, or paste a whole list into the textarea.' },
  { n: 2, title: 'Flip the switch', body: 'One toggle in the side panel, or your own keyboard shortcut.' },
  { n: 3, title: 'Get a polite "not now"', body: 'The mascot greets you instead of the feed. Need the site? Switch blocking off.' },
];
---

<section id="how" class="py-24 md:py-32 px-4 md:px-6 bg-background border-t border-border">
  <div class="container mx-auto max-w-5xl">
    <div class="text-center mb-14">
      <h2 class="text-4xl md:text-6xl font-bold tracking-tight mb-6 leading-[1.1] rv">
        <span class="bg-clip-text text-transparent bg-gradient-to-b from-foreground to-foreground/60">How it works</span>
      </h2>
      <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto rv" style="--d:1">
        Three small steps. After that it stays out of your way.
      </p>
    </div>

    <div class="rv demo-frame rounded-3xl overflow-hidden border border-border shadow-glow mb-14">
      <img src="/demo.svg" width="1060" height="590" alt="Animated demo: the toggle in the side panel switches on and the YouTube feed is replaced by a Not now page with the guardian mascot" class="block w-full h-auto" loading="lazy" />
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 list-none p-0">
      {steps.map((s, i) => (
        <li class="rv relative bg-card/40 border border-border rounded-2xl p-7" style={`--d:${i}`}>
          <span class="step-n inline-flex h-10 w-10 items-center justify-center rounded-full bg-accent/10 border border-accent/30 text-accent font-bold mb-5">{s.n}</span>
          <h3 class="text-xl font-bold mb-2 tracking-tight">{s.title}</h3>
          <p class="text-sm md:text-base text-muted-foreground leading-relaxed">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
